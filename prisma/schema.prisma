generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  /** Direction / gérant : toutes les pages admin dont caisse et vue d'ensemble. */
  SUPER_ADMIN
  MEMBRE
  COACH
}

enum QrCodeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum PlanningLevel {
  ALL_LEVELS
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BookingWindow {
  WEEKLY
  FIFTEEN_DAYS
  ONE_MONTH
}

/// Rémunération coach en caisse : à la séance (planning) ou forfait mensuel fixe.
enum CoachPayrollMode {
  PER_SESSION
  PER_MONTH
}

enum ReservationStatus {
  BOOKED
  WAITLIST
  CANCELLED
  ATTENDED
}

enum ReservationSource {
  MEMBER
  ADMIN
}

/// Encaissement pack : source de vérité pour les entrées caisse (ventes pack adhérentes).
enum PackPaymentSource {
  AUTO
  MANUAL
}

/// Statut d'inscription pack : acompte en cours ou adhérente active (liste principale).
enum MemberEnrollmentStatus {
  ACTIVE
  DEPOSIT_PENDING
}

/// Nature de l'encaissement pack (historique caisse).
enum PackPaymentKind {
  FULL
  DEPOSIT
  BALANCE
}

/// Moyen d'encaissement (espèce, chèque, TPE).
enum PackPaymentMethod {
  CASH
  CHECK
  TPE
}

enum PersonalDiscountType {
  PERCENT
  AMOUNT
}

enum CashExpenseKind {
  FIXED
  VARIABLE
}

enum SessionProspectStatus {
  ACTIVE
  CONVERTED
  PAID_TRIAL
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  image          String?
  password       String?
  role           UserRole  @default(MEMBRE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions          Session[]
  memberProfile     Member?
  coachProfile      Coach?
  createdQrCodes    QrCode[]       @relation("QrCodeCreatedBy")
  createdReservations Reservation[] @relation("ReservationCreatedBy")
  createdSessionProspects SessionProspect[] @relation("SessionProspectCreatedBy")
  recordedPackPayments PackPayment[] @relation("PackPaymentRecordedBy")
  recordedCashExpenses CashExpense[]  @relation("CashExpenseRecordedBy")

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Member {
  id              String   @id @default(cuid())
  userId          String?  @unique
  firstName       String?
  lastName        String?
  phone           String?
  birthDate       DateTime?
  packId          String?
  packStartedAt   DateTime?
  personalDiscountType  PersonalDiscountType?
  personalDiscountValue Int?
  personalDiscountReason String?
  enrollmentStatus       MemberEnrollmentStatus @default(ACTIVE)
  /// Montant total attendu pour le pack en cours (acompte + solde).
  expectedPackAmountDinars Int?
  /// Note interne staff (optionnelle).
  note            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack            Pack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  assignedQrCodes QrCode[] @relation("QrCodeAssignedMember")
  checkIns        CheckIn[]
  reservations    Reservation[]
  attendance      Attendance[]
  packBalances    MemberPackBalance[]
  packPayments    PackPayment[]
  pendingPacks    MemberPendingPack[]
  packEnrollments MemberPackEnrollment[]
  convertedFromProspects SessionProspect[] @relation("ProspectConvertedMember")

  @@index([packId])
  @@map("members")
}

enum MemberPackEnrollmentStatus {
  PENDING_START
  ACTIVE
  EXPIRED
  REPLACED
}

/// Une inscription pack = un achat ou renouvellement distinct (dates début/fin propres).
model MemberPackEnrollment {
  id            String                     @id @default(cuid())
  memberId      String
  packId        String
  packPaymentId String?                    @unique
  purchasedAt   DateTime                   @default(now())
  packStartedAt DateTime?
  packExpiresAt DateTime?
  status        MemberPackEnrollmentStatus   @default(PENDING_START)
  closedAt      DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pack        Pack         @relation(fields: [packId], references: [id], onDelete: Cascade)
  packPayment PackPayment? @relation(fields: [packPaymentId], references: [id], onDelete: SetNull)

  @@index([memberId, purchasedAt])
  @@index([memberId, packId])
  @@map("member_pack_enrollments")
}

/// Pack acheté en avance : activé automatiquement quand le pack en cours est terminé (séances épuisées ou expiré).
model MemberPendingPack {
  id        String   @id @default(cuid())
  memberId  String
  packId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pack   Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([memberId, position])
  @@map("member_pending_packs")
}

model MemberPackBalance {
  id         String   @id @default(cuid())
  memberId   String
  packId     String
  courseSlug String?
  remaining  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pack   Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([memberId, packId, courseSlug])
  @@index([memberId])
  @@index([packId])
  @@map("member_pack_balances")
}

enum PackDiscountType {
  PERCENT
}

model Pack {
  id           String   @id @default(cuid())
  category     String?
  name         String   @unique
  description  String?
  sessionCount Int?
  /// Prix en dinars (entier), ex. 100 → affichage « 100 DT ». Nom de colonne historique.
  priceCents   Int?
  /// Duree libelle, ex. « 50 jours », « 12 mois » (nom de colonne historique).
  durationDays String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      Member[]
  features     PackFeature[]
  courseQuotas PackCourseQuota[]
  memberBalances MemberPackBalance[]
  promotionTargets PackPromotionPack[]
  packPayments     PackPayment[]
  pendingForMembers MemberPendingPack[]
  packEnrollments  MemberPackEnrollment[]
  debitedReservations Reservation[] @relation("ReservationDebitedPack")
  trialProspectPayments SessionProspect[] @relation("ProspectTrialPack")

  @@map("packs")
}

/// Vente / encaissement d'un pack adhérente (entrée caisse). Montants en dinars entiers.
model PackPayment {
  id               String            @id @default(cuid())
  memberId         String
  packId           String
  /// Montant réellement encaissé (après promo éventuelle).
  amountDinars     Int
  /// Prix catalogue au moment du paiement (sans promo), pour audit.
  listPriceDinars  Int?
  /// Total attendu pour la vente (acompte + solde), renseigné pour DEPOSIT/BALANCE.
  packSaleTotalDinars Int?
  /// Remise personnalisée appliquée au membre (optionnelle).
  personalDiscountType  PersonalDiscountType?
  /// Valeur brute saisie (%, ou montant en DT selon le type).
  personalDiscountValue Int?
  /// Montant réellement déduit par la remise personnalisée.
  personalDiscountDinars Int @default(0)
  paidAt           DateTime          @db.Date
  source           PackPaymentSource
  paymentKind      PackPaymentKind   @default(FULL)
  paymentMethod    PackPaymentMethod?
  promotionId      String?
  note             String?
  recordedByUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  member      Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pack        Pack           @relation(fields: [packId], references: [id], onDelete: Restrict)
  promotion   PackPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  recordedBy  User?          @relation("PackPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  enrollment  MemberPackEnrollment?

  @@index([paidAt])
  @@index([memberId, paidAt])
  @@index([packId, paidAt])
  @@map("pack_payments")
}

/// Charge studio (saisie manuelle — loyer, fournitures, etc.).
model CashExpense {
  id               String           @id @default(cuid())
  kind             CashExpenseKind
  label            String
  amountDinars     Int
  expenseDate      DateTime         @db.Date
  note             String?
  recordedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  recordedBy User? @relation("CashExpenseRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@map("cash_expenses")
}

model PackPromotion {
  id            String           @id @default(cuid())
  label         String?
  appliesToAll  Boolean          @default(false)
  discountType  PackDiscountType @default(PERCENT)
  discountValue Int
  startsAt      DateTime         @db.Date
  endsAt        DateTime         @db.Date
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  targetPacks   PackPromotionPack[]
  packPayments  PackPayment[]

  @@index([startsAt, endsAt])
  @@index([isActive])
  @@map("pack_promotions")
}

model PackPromotionPack {
  promotionId String
  packId      String
  createdAt   DateTime @default(now())

  promotion PackPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  pack      Pack          @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([promotionId, packId])
  @@index([packId])
  @@map("pack_promotion_packs")
}

model PackCourseQuota {
  id           String   @id @default(cuid())
  packId       String
  courseSlug   String
  sessionCount Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, courseSlug])
  @@index([packId])
  @@index([courseSlug])
  @@map("pack_course_quotas")
}

model PackFeature {
  id        String   @id @default(cuid())
  packId    String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@index([packId, sortOrder])
  @@map("pack_features")
}

model Coach {
  id                String   @id @default(cuid())
  userId            String?  @unique
  imageUrl          String?
  firstName         String
  lastName          String
  description       String?
  email             String?  @unique
  phone             String?
  /// Coût studio par séance (DT) — si payrollMode = PER_SESSION.
  sessionCostDinars   Int?
  /// Forfait mensuel (DT) — si payrollMode = PER_MONTH (charge fixe, indépendant du planning).
  monthlySalaryDinars Int?
  payrollMode         CoachPayrollMode @default(PER_SESSION)
  isActive            Boolean          @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  planning          Planning[]
  assignedQrCodes   QrCode[] @relation("QrCodeAssignedCoach")

  @@index([lastName, firstName])
  @@map("coaches")
}

enum DraftPublicationPhase {
  SCHEDULED
  PARTIAL
}

/// Période planning studio (singleton) — date de début + durée (7 / 15 / 30 j).
model StudioPlanningPeriod {
  id              String        @id @default("singleton")
  bookingWindow   BookingWindow @default(WEEKLY)
  periodStartDate DateTime      @db.Date
  /// Période suivante en préparation (invisible adhérentes jusqu'à draftPublishAt).
  draftPeriodStartDate DateTime? @db.Date
  draftBookingWindow   BookingWindow?
  /// Samedi 13h : ouverture lun–sam du brouillon.
  draftPublishAt       DateTime?
  /// Dimanche 13h : ouverture du dimanche brouillon + bascule complète.
  draftSundayPublishAt DateTime?
  draftPublicationPhase DraftPublicationPhase?
  /// Règle membre : annulation tardive (< 6 h) = séance non rendue. Si false, toute annulation rend la séance.
  lateCancellationRuleEnabled Boolean @default(true)
  /// Plage horaire quotidienne : les adhérentes peuvent réserver en ligne (HH:MM, fuseau local studio).
  memberReservationOpenTime  String @default("08:00")
  memberReservationCloseTime String @default("22:00")
  updatedAt       DateTime      @updatedAt

  @@map("studio_planning_period")
}

/// Historique des périodes planning publiées (pour caisse / paie coach sur mois passés).
model StudioPlanningPeriodArchive {
  id              String        @id @default(cuid())
  bookingWindow   BookingWindow
  periodStartDate DateTime      @db.Date
  periodEndDate   DateTime      @db.Date
  archivedAt      DateTime      @default(now())

  @@unique([periodStartDate])
  @@index([periodStartDate, periodEndDate])
  @@map("studio_planning_period_archive")
}

model Planning {
  id               String    @id @default(cuid())
  courseSlug       String
  coachId          String?
  dayOfWeek        DayOfWeek
  /// Jour calendaire de la période à la création (une seule séance ce jour-là). Null = récurrent sur tous les jours correspondants dans la période.
  anchorSessionYmd DateTime? @db.Date
  level            PlanningLevel?
  bookingWindow    BookingWindow @default(WEEKLY)
  startTime        String    @default("00:00")
  endTime          String    @default("00:00")
  durationMinutes  Int
  capacity         Int
  waitlistCapacity Int?
  /// Créneau brouillon (période suivante) — masqué adhérentes / site jusqu'à publication.
  isDraft          Boolean   @default(false)
  /// Lien vers le créneau publié source (sync publié → brouillon).
  draftSourceId    String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  coach            Coach?    @relation(fields: [coachId], references: [id], onDelete: SetNull)
  draftSource      Planning? @relation("PlanningDraftMirror", fields: [draftSourceId], references: [id], onDelete: Cascade)
  draftMirrors     Planning[] @relation("PlanningDraftMirror")
  reservations     Reservation[]
  attendance       Attendance[]
  sessionProspects SessionProspect[]

  @@index([dayOfWeek])
  @@index([coachId])
  @@index([courseSlug])
  @@index([dayOfWeek, startTime])
  @@index([isDraft])
  @@map("planning")
}

/// Séance d'essai pour une personne non adhérente (occupe une place du créneau).
model SessionProspect {
  id                  String                @id @default(cuid())
  planningId          String
  sessionDate         DateTime              @db.Date
  firstName           String
  lastName            String
  phone               String
  courseSlug          String
  status              SessionProspectStatus @default(ACTIVE)
  convertedMemberId   String?
  trialPaymentDinars  Int?
  trialPaymentMethod  PackPaymentMethod?
  trialPaidAt         DateTime?
  trialPackId         String?
  trialListPriceDinars Int?
  trialPersonalDiscountType PersonalDiscountType?
  trialPersonalDiscountValue Int?
  trialPersonalDiscountReason String?
  trialPersonalDiscountDinars Int @default(0)
  createdByUserId     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  planning        Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)
  convertedMember Member?  @relation("ProspectConvertedMember", fields: [convertedMemberId], references: [id], onDelete: SetNull)
  trialPack       Pack?    @relation("ProspectTrialPack", fields: [trialPackId], references: [id], onDelete: SetNull)
  createdByUser   User?    @relation("SessionProspectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([planningId, sessionDate])
  @@index([status])
  @@map("session_prospects")
}

model Reservation {
  id          String            @id @default(cuid())
  memberId    String
  planningId  String
  sessionDate DateTime          @db.Date
  status      ReservationStatus @default(BOOKED)
  source      ReservationSource?
  createdByUserId String?
  packRefundedAt DateTime?
  debitedPackId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planning    Planning          @relation(fields: [planningId], references: [id], onDelete: Cascade)
  debitedPack Pack?             @relation("ReservationDebitedPack", fields: [debitedPackId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attendance  Attendance?
  checkIn     CheckIn?

  @@unique([memberId, planningId, sessionDate])
  @@index([planningId, sessionDate])
  @@index([memberId, sessionDate])
  @@index([createdByUserId])
  @@map("reservations")
}

model Attendance {
  id            String      @id @default(cuid())
  reservationId String      @unique
  memberId      String
  planningId    String
  sessionDate   DateTime    @db.Date
  markedAt      DateTime    @default(now())
  markedBy      String      @default("STAFF_KEY") // "STAFF_KEY" | "ADMIN"

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planning    Planning    @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId, sessionDate])
  @@index([memberId, sessionDate])
  @@map("attendance")
}

model QrCode {
  id              String         @id @default(cuid())
  publicId        String         @unique
  qrKey           String         @default("")
  name            String
  status          QrCodeStatus   @default(DRAFT)
  assignedMemberId String?
  assignedCoachId  String?
  createdByUserId String
  assignedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  assignedMember  Member?        @relation("QrCodeAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  assignedCoach   Coach?         @relation("QrCodeAssignedCoach", fields: [assignedCoachId], references: [id], onDelete: SetNull)
  createdByUser   User           @relation("QrCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  checkIns        CheckIn[]

  @@index([publicId])
  @@index([status])
  @@index([assignedMemberId])
  @@index([assignedCoachId])
  @@index([createdByUserId])
  @@map("qrcodes")
}

model CheckIn {
  id            String   @id @default(cuid())
  memberId      String
  qrCodeId      String
  reservationId String?  @unique
  scannedAt     DateTime @default(now())
  method        String // "STAFF_KEY" | "ADMIN_SESSION" (kept string for flexibility)

  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  qrCode      QrCode       @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([qrCodeId])
  @@index([scannedAt])
  @@map("checkins")
}
